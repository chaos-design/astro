{
  "description": "Capture WorkBuddy and CodeBuddy Code lifecycle events in the local ASTRO data store.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/plugin/trace-recorder.cjs\" --source=workbuddy --event=SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEBUDDY_PLUGIN_ROOT}/plugin/trace-recorder.cjs\" --source=workbuddy --event=SessionEnd",
