# Optional local values for config.yaml and environment-style overrides.
# Installed as <ASTRO_HOME>/plugins/astro/.env with mode 0600.
# Inherited process variables take precedence over values in this file.
#
# ASTRO_HOME is intentionally not supported here because it determines where
# this file is located. Set ASTRO_HOME before installation or use --astro-home.

# ASTRO_HOST=127.0.0.1
# ASTRO_PORT=4318
# ASTRO_MAX_BODY_BYTES=5242880
# ASTRO_AUTO_OPEN=1
# ASTRO_TRACE_DIR=
# ASTRO_PROJECT_DIR=

# CODEX_HOME=~/.codex
# CLAUDE_HOME=~/.claude
# DSH_HOME=~/.dsh
# DSH_COMMAND=dsh
# CODEBUDDY_HOME=~/.codebuddy
# CODEBUDDY_COMMAND=codebuddy

# Add private values referenced by config.yaml here.
# EXAMPLE_API_KEY=
